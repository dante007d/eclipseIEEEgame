# Client Environment Variables (for Vercel Deployment)
# Choose backend transport:
#   - Leave VITE_SUPABASE_URL blank to use local Socket.io server (VITE_SOCKET_URL)
#   - Set VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY to use Supabase backend on Vercel

VITE_BACKEND_MODE=auto
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SOCKET_URL=http://localhost:3001
